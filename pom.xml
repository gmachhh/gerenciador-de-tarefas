<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Identificação do projeto -->
    <groupId>br.com.tarefas</groupId>
    <artifactId>gerenciador-tarefas</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Gerenciador de Tarefas</name>
    <description>Aplicação de linha de comando para gerenciar tarefas</description>

    <properties>
        <!-- Compila para Java 17, assim roda em qualquer Java 17 ou mais novo -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>6.1.3</junit.version>
    </properties>

    <!-- Bibliotecas externas: o Maven baixa sozinho do Maven Central -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope> <!-- só é usada nos testes, não vai junto no programa final -->
        </dependency>
    </dependencies>

    <build>
        <finalName>gerenciador-tarefas</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>

            <!-- Roda os testes JUnit no comando "mvnw test" -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>

            <!-- Gera um .jar executável com "java -jar target/gerenciador-tarefas.jar" -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
